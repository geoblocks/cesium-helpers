{
  "compilerOptions": {
    "target": "ES2025",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["es2025", "dom"],
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true
  },
  "include": ["packages/**/*.js"],
  "exclude": ["packages/**/*.test.js"]
}
