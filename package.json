{
  "name": "cesium-helpers",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build-demos": "vite build",
    "build-shaders": "node scripts/build-shaders.js",
    "dev": "vite",
    "gh-pages": "npm run build-demos && gh-pages -d dist",
    "prepare": "npm run build-shaders",
    "test": "node --test \"packages/**/*.test.js\"",
    "typecheck": "tsc --pretty"
  },
  "devDependencies": {
    "@awesome.me/webawesome": "3.14.0",
    "@camptocamp/ogc-client": "2.0.2",
    "@cesium/core": "0.1.0",
    "@cesium/engine": "26.4.0",
    "gh-pages": "6.3.0",
    "jsfive": "0.4.2",
    "lerna": "10.0.1",
    "mediabunny": "1.61.1",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
