{
  "name": "@geoblocks/cesium-bvh",
  "version": "0.4.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/geoblocks/cesium-helpers/",
    "directory": "packages/cesium-bvh"
  },
  "main": "dist/cesium-bvh.js",
  "module": "dist/cesium-bvh.js",
  "types": "dist/cesium-bvh.d.ts",
  "exports": {
    ".": {
      "source": "./src/cesium-bvh.js",
      "types": "./dist/cesium-bvh.d.ts",
      "default": "./dist/cesium-bvh.js"
    },
    "./gltf": {
      "source": "./src/gltf.js",
      "types": "./dist/gltf.d.ts",
      "default": "./dist/gltf.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.js"
  ],
  "scripts": {
    "build": "tsc -p .",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  }
}
